# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# From your Spotify app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Optional: a playlist of yours that best represents your taste (URL or ID), mirrored into
# taste/ to steer suggestions. Without it, suggestions use your Spotify listening history.
# TASTE_PLAYLIST=https://open.spotify.com/playlist/your_playlist_id_here

# For `similar` and `tag` (what Last.fm listeners say sounds alike). Free key:
# https://www.last.fm/api/account/create — only the "API key" is needed, not the secret.
# LASTFM_API_KEY=your_lastfm_api_key_here

# Optional tuning for the taste reference.
# TASTE_HALF_LIFE_DAYS=365
# TASTE_MAX_AGE_HOURS=24
